        {
          "name": "GET Echo Query Parameters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{echo_base_url}}/get?search=laravel api&page=2",
              "host": [
                "{{echo_base_url}}"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "laravel api"
                },
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Echo Custom Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Custom header was received\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.headers[\"x-student-client\"]).to.eql(\"postman-week-2\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Student-Client",
                "value": "postman-week-2"
              }
            ],
            "url": {
              "raw": "{{echo_base_url}}/get?Accept=application/json X-Student-Client=postman-week-2",
              "host": [
                "{{echo_base_url}}"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "Accept",
                  "value": "application/json X-Student-Client=postman-week-2"
                }
              ]
            }
          },
          "response": []
        }
